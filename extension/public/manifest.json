{
  "manifest_version": 3,
  "name": "Maya",
  "description": "Talk to Maya, your AI companion, from the Chrome toolbar.",
  "version": "0.1.0",
  "action": {
    "default_title": "Talk to Maya",
    "default_popup": "index.html",
    "default_icon": {
      "192": "icon-192.png"
    }
  },
  "icons": {
    "192": "icon-192.png",
    "512": "icon-512.png"
  },
  "host_permissions": ["http://localhost:8000/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
