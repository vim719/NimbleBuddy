AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hey, it's nice to hear from you. Tell me your name so I can remember you.
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY is optional — the voice platform manages the OpenAI key by default (keyless).
# OPENAI_API_KEY=sk-your-openai-key
MEMORY_DB_PATH=memory.db
MEMORY_MAX_TURNS=20

# Optional — Nimble web search for Anna (https://online.nimbleway.com → Settings → API Keys).
# Leave unset to disable web search.
# NIMBLE_API_KEY=

# Optional — CoinGecko live crypto prices for Market Pulse (works without a key, rate-limited).
# COINGECKO_API_KEY=
